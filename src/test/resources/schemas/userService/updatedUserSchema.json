{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "firstName",
    "phone",
    "gender",
    "company",
    "bank",
    "address",
    "image",
    "age",
    "email",
    "username",
    "lastName",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "firstName": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "gender": {
      "type": "string"
    },
    "company": {
      "type": "object",
      "required": [
        "department",
        "title",
        "name"
      ],
      "properties": {
        "department": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "bank": {
      "type": "object",
      "required": [
        "iban",
        "cardNumber",
        "cardType",
        "currency"
      ],
      "properties": {
        "iban": {
          "type": "string"
        },
        "cardNumber": {
          "type": "string"
        },
        "cardType": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        }
      }
    },
    "address": {
      "type": "object",
      "required": [
        "postalCode",
        "city",
        "street",
        "country",
        "state"
      ],
      "properties": {
        "postalCode": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      }
    },
    "image": {
      "type": "string"
    },
    "age": {
      "type": "integer"
    },
    "email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "updated": {
      "type": "boolean"
    }
  }
}